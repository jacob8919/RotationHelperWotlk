diff --git a/sim/druid/whitemane.go b/sim/druid/whitemane.go
new file mode 100644
index 0000000..17801dc
--- /dev/null
+++ b/sim/druid/whitemane.go
@@ -0,0 +1,28 @@
+package druid
+
+// Whitemane Frostmourne's druid threat changes ("Frostmourne Beta Class Changes",
+// 2026-08-22): Bear Form threat bonus 45% -> 65%, Swipe (Bear) threat multiplier
+// 1.5 -> 1.65, Faerie Fire (Feral) extra threat in bear forms +10%.
+// Off by default (stock WotLK values).
+var WhitemaneThreat = false
+
+func bearFormThreat() float64 {
+	if WhitemaneThreat {
+		return 2.1021 * 1.65 / 1.45
+	}
+	return 2.1021
+}
+
+func swipeBearThreat() float64 {
+	if WhitemaneThreat {
+		return 1.65
+	}
+	return 1
+}
+
+func faerieFireBearThreat() float64 {
+	if WhitemaneThreat {
+		return 632 * 1.1
+	}
+	return 632
+}
